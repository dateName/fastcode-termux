{
  "name": "@datename/fastcode-termux",
  "version": "0.1.5",
  "description": "FastCode — a blazing-fast TUI coding assistant. Multi-LLM, skills.sh skills, slash commands. Works on Termux, Linux, Windows, and macOS.",
  "type": "module",
  "bin": {
    "fastcode": "bin/fastcode.mjs",
    "fc": "bin/fastcode.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "src",
    "tsconfig.json",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "build:bundle": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "start": "node bin/fastcode.mjs",
    "check": "npm test && npm run typecheck && npm run lint && npm run build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tui",
    "cli",
    "ai",
    "coding-agent",
    "claude",
    "claude-code",
    "openclaude",
    "fastcode",
    "skills",
    "termux",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "ollama",
    "deepseek",
    "groq",
    "mistral",
    "agent",
    "ink",
    "react"
  ],
  "author": "SimpleLittleDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dateName/fastcode-termux.git"
  },
  "homepage": "https://github.com/dateName/fastcode-termux#readme",
  "bugs": {
    "url": "https://github.com/dateName/fastcode-termux/issues"
  },
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "figures": "^6.1.0",
    "gradient-string": "^2.0.2",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-markdown": "^1.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.2",
    "marked-terminal": "^7.1.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
